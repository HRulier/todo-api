{
  "compilerOptions": {
    "target": "es2022",
    "module": "CommonJS",
    "lib": ["es2022", "dom"], // components react-email
    "outDir": "./dist",
    // "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"],
      "~~/*": ["./*"],
      "@modelcontextprotocol/sdk/server/mcp": ["./node_modules/@modelcontextprotocol/sdk/dist/esm/server/mcp.d.ts"],
      "@modelcontextprotocol/sdk/server/streamableHttp": ["./node_modules/@modelcontextprotocol/sdk/dist/esm/server/streamableHttp.d.ts"]
    },
    "jsx": "react",
    "declaration": true
  },
  "include": ["src/**/*", "tests/**/*", "jest.config.tstests/setup.ts"],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
