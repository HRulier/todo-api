{
  "UserInputRegister": {
    "type": "object",
    "required": ["email", "password", "profile.lastName", "profile.firstName"],
    "properties": {
      "email": {
        "type": "string",
        "format": "email",
        "description": "The user's email address",
        "example": "user@example.com"
      },
      "password": {
        "type": "string",
        "format": "email",
        "description": "Thhe user's password",
        "example": "strongpassword?123"
      },
      "profile": {
        "type": "object",
        "description": "The user's profile information",
